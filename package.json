{
  "name": "zeron-design",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Carlosfengv/zeron-ui.git"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app docs scripts tests types packages eslint.config.mjs vitest.config.mts next.config.ts postcss.config.mjs --max-warnings=0",
    "test": "vitest run --config vitest.config.mts",
    "test:i18n:unit": "vitest run --config vitest.config.mts tests/i18n-message-parity.test.ts tests/i18n-document-manifest.test.ts tests/i18n-routing.test.ts",
    "test:i18n:production": "pnpm build && vitest run --config vitest.config.mts tests/i18n-production-smoke.test.ts",
    "test:i18n:e2e": "pnpm build && playwright test --config playwright.config.ts",
    "test:focus:e2e": "pnpm build && playwright test --config playwright.focus.config.ts",
    "test:i18n:payload": "pnpm build && node scripts/check-i18n-client-payload.mjs",
    "tokens:build": "node scripts/generate-semantic-tokens.mjs",
    "tokens:check": "node scripts/generate-semantic-tokens.mjs --check",
    "registry:build": "pnpm tokens:build && pnpm --filter @zeron/registry build",
    "cli:check": "pnpm --filter zeron-ui check",
    "cli:test": "pnpm --filter zeron-ui test"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@hugeicons/core-free-icons": "^4.1.1",
    "@hugeicons/react": "^1.1.6",
    "@lobehub/icons": "^5.16.0",
    "@thesvg/icons": "^3.2.15",
    "@shikijs/langs": "3.22.0",
    "@shikijs/themes": "3.22.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.9",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "@zeron/blocks": "workspace:*",
    "@zeron/icons": "workspace:*",
    "@zeron/tokens": "workspace:*",
    "@zeron/ui": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "dialkit": "^1.1.0",
    "framer-motion": "^12.34.0",
    "motion": "^12.42.2",
    "next": "15.5.9",
    "next-intl": "^4.13.6",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.2.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.0",
    "shadcn": "^3.0.0",
    "shiki": "^3.22.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@formatjs/icu-messageformat-parser": "^2.11.4",
    "@next/eslint-plugin-next": "15.5.12",
    "@playwright/test": "^1.55.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^20.19.9",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "8.56.0",
    "@typescript-eslint/parser": "8.56.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "^15.3.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
