{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/components/*": [
        "./src/components/*"
      ],
      "@/docs/*": [
        "./src/docs/*"
      ],
      "@/i18n/*": [
        "./src/i18n/*"
      ],
      "@/hooks/*": [
        "./src/system/hooks/*"
      ],
      "@/lib/*": [
        "./src/system/*"
      ],
      "@/*": [
        "./*"
      ],
      "@/app-providers": [
        "./src/app-providers.tsx"
      ],
      "@/messages/*": [
        "./messages/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
