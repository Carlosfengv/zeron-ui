{
  "name": "zeron-ui",
  "version": "0.2.0-beta.3",
  "description": "Install Zeron Design components into your project.",
  "type": "module",
  "bin": {
    "zeron-ui": "src/index.js"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.18.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "node ./src/index.js --help",
    "test": "node --test",
    "prepublishOnly": "pnpm check && pnpm test"
  },
  "dependencies": {
    "shadcn": "3.0.0",
    "typescript": "5.9.3"
  },
  "keywords": [
    "zeron-ui",
    "zeron-design",
    "react",
    "components",
    "shadcn",
    "cli"
  ],
  "license": "MIT",
  "homepage": "https://zeron-ui.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Carlosfengv/zeron-ui.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/Carlosfengv/zeron-ui/issues"
  }
}
